# Required: Neon PostgreSQL connection string for Prisma.
# Copy it from the Neon dashboard and keep sslmode=require. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require"

# Required: use a long, random value. Do not reuse this example value.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: defaults to 7d when omitted.
JWT_EXPIRES_IN="7d"

# Optional: use "development" locally and "production" when deploying.
NODE_ENV="development"
